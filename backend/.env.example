# Runtime environment: development, test, or production
NODE_ENV=development

# Port used by the Express API server
PORT=4000

# Frontend origin permitted to call the API once frontend integration begins
CORS_ORIGIN=http://localhost:5173

# Local Docker PostgreSQL settings. These are development-only values.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev_password
POSTGRES_PORT=5432

# Prisma's PostgreSQL connection string
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow?schema=public

# Authentication. Replace both values with different cryptographically random secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

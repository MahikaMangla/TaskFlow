generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum Availability {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_STATUS_CHANGED
  TASK_UPDATED
  TASK_DELETED
  TASK_ASSIGNED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  SPRINT_CREATED
  SPRINT_UPDATED
  SPRINT_COMPLETED
  SPRINT_DELETED
  TEAM_MEMBER_UPDATED
  TEAM_MEMBER_REMOVED
  COMMENT_ADDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectRole {
  PROJECT_MANAGER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  DEVELOPER
  UI_UX_DESIGNER
  QA_ENGINEER
  PRODUCT_MANAGER
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  members     WorkspaceMember[]
  projects    Project[]
  sprints     Sprint[]
  tasks       Task[]
  labels      Label[]
  activities  Activity[]
  invitations Invitation[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("workspaces")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  passwordHash       String?           @map("password_hash")
  name               String
  initials           String
  title              String?
  roleKey            String?           @map("role_key")
  department         String?
  color              String?           @default("#6366f1")
  avatarUrl          String?           @map("avatar_url")
  availability       Availability      @default(AVAILABLE)
  capacity           Int               @default(100)
  bio                String?
  location           String?
  timezone           String?
  joinedAt           DateTime?         @map("joined_at")
  workspaceMemberships WorkspaceMember[]
  ownedProjects      Project[]         @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  activities         Activity[]        @relation("ActivityActor")
  refreshTokens      RefreshToken[]
  sentInvitations    Invitation[]      @relation("InvitationInviter")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  ownerId     String        @map("owner_id")
  name        String
  description String?
  color       String        @default("#6366f1")
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?     @db.Date @map("start_date")
  endDate     DateTime?     @db.Date @map("end_date")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]
  activities  Activity[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Sprint {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  name            String
  goal            String
  description     String?
  status          SprintStatus @default(PLANNING)
  startDate       DateTime     @db.Date @map("start_date")
  endDate         DateTime     @db.Date @map("end_date")
  committedPoints Int          @default(0) @map("committed_points")
  completedPoints Int          @default(0) @map("completed_points")
  velocity        Int?
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks           Task[]
  activities      Activity[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("sprints")
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  projectId   String     @map("project_id")
  sprintId    String?    @map("sprint_id")
  assigneeId  String?    @map("assignee_id")
  creatorId   String     @map("creator_id")
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  storyPoints Int?       @map("story_points")
  dueDate     DateTime?  @db.Date @map("due_date")
  position    Int        @default(0)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  labels      TaskLabel[]
  activities  Activity[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([workspaceId, status, position])
  @@index([projectId, updatedAt])
  @@index([sprintId])
  @@index([assigneeId, status])
  @@map("tasks")
}

model Label {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String
  color       String?
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskLabel[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  actorId     String       @map("actor_id")
  projectId   String?      @map("project_id")
  sprintId    String?      @map("sprint_id")
  taskId      String?      @map("task_id")
  type        ActivityType
  description String
  metadata    Json?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@map("activities")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  inviterId   String           @map("inviter_id")
  email       String
  role        WorkspaceRole    @default(MEMBER)
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  metadata    Json?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter     User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([workspaceId, email])
  @@index([email, status])
  @@map("invitations")
}
